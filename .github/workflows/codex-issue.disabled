name: Codex Issue Agent

on:
  issue_comment:
    types: [created]

concurrency:
  group: codex-issue-${{ github.event.issue.number }}
  cancel-in-progress: false

jobs:
  codex:
    name: Implement issue with Codex

    if: |
      github.event.issue.pull_request == null &&
      contains(github.event.comment.body, '@codex implement') &&
      (
        github.event.comment.author_association == 'OWNER' ||
        github.event.comment.author_association == 'MEMBER' ||
        github.event.comment.author_association == 'COLLABORATOR'
      )

    runs-on: ubuntu-latest

    permissions:
      contents: write
      issues: write
      pull-requests: write

    env:
      ISSUE_NUMBER: ${{ github.event.issue.number }}
      ISSUE_TITLE: ${{ github.event.issue.title }}
      BRANCH_NAME: codex/issue-${{ github.event.issue.number }}

    steps:

      # =========================================================
      # CHECKOUT
      # =========================================================

      - name: Checkout repository
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      # =========================================================
      # .NET
      # =========================================================

      - name: Setup .NET
        uses: actions/setup-dotnet@v5
        with:
          dotnet-version: '8.0.x'

      # =========================================================
      # GIT
      # =========================================================

      - name: Configure Git
        shell: bash
        run: |
          git config user.name "codex-agent"
          git config user.email "codex-agent@users.noreply.github.com"

      - name: Create Codex branch
        shell: bash
        run: |
          git fetch origin main

          if git ls-remote --exit-code --heads origin "$BRANCH_NAME"; then

            echo "Branch $BRANCH_NAME already exists."

            git fetch origin "$BRANCH_NAME"

            git checkout -B \
              "$BRANCH_NAME" \
              "origin/$BRANCH_NAME"

          else

            echo "Creating $BRANCH_NAME from main."

            git checkout \
              -b "$BRANCH_NAME" \
              origin/main

          fi

      # =========================================================
      # CODEX
      # =========================================================

      - name: Implement issue with Codex
        id: codex
        uses: openai/codex-action@v1
        with:

          openai-api-key: ${{ secrets.OPENAI_API_KEY }}

          permission-profile: ":workspace"

          safety-strategy: drop-sudo

          prompt: |
            You are an autonomous senior software engineer.

            Repository:
            ${{ github.repository }}

            Implement GitHub Issue:
            #${{ github.event.issue.number }}

            =====================================================
            ISSUE TITLE
            =====================================================

            ${{ github.event.issue.title }}

            =====================================================
            ISSUE DESCRIPTION
            =====================================================

            ${{ github.event.issue.body }}

            =====================================================
            USER COMMAND
            =====================================================

            ${{ github.event.comment.body }}

            =====================================================
            REPOSITORY STRUCTURE
            =====================================================

            Backend:

            source/backend/BackAssistanceTravelers/

            Solution:

            source/backend/BackAssistanceTravelers/
            BackAssistanceTravelers.sln


            Frontend:

            source/frontend/FrontAssistanceTravelers/

            Solution:

            source/frontend/FrontAssistanceTravelers/
            FrontAssistanceTravelers.sln


            Both applications currently target .NET 8.

            =====================================================
            INSTRUCTIONS
            =====================================================

            1. Read AGENTS.md before making changes.

            2. Understand the issue completely before modifying code.

            3. Inspect the existing implementation before proposing
               a solution.

            4. Follow the existing architecture and coding conventions.

            5. Implement the smallest correct solution.

            6. Do not modify unrelated files.

            7. Do not modify GitHub Actions workflows unless explicitly
               required by the issue.

            8. Do not commit.

            9. Do not push.

            10. Do not create Pull Requests.

            11. Do not merge anything.

            GitHub Actions manages all Git operations.

            =====================================================
            BACKEND
            =====================================================

            Backend source:

            source/backend/BackAssistanceTravelers/

            If backend changes are necessary:

            - inspect the complete backend architecture;
            - preserve dependency boundaries;
            - follow existing repository patterns;
            - avoid unnecessary API contract changes.

            =====================================================
            FRONTEND
            =====================================================

            Frontend source:

            source/frontend/FrontAssistanceTravelers/

            This frontend is currently ASP.NET Core .NET 8,
            not Angular.

            Follow the existing ASP.NET Core architecture.

            =====================================================
            VALIDATION
            =====================================================

            You may inspect and validate the code.

            GitHub Actions will independently perform the authoritative
            build after your modifications.

            =====================================================
            FINAL RESPONSE
            =====================================================

            Return:

            - Requirement / root cause
            - Solution implemented
            - Files modified
            - Validation performed
            - Risks
            - Follow-up work if necessary

      # =========================================================
      # DETECTAR QUÉ CAMBIÓ
      # =========================================================

      - name: Detect changed areas
        id: changes
        shell: bash
        run: |

          echo "Changed files:"

          git status --short

          BACKEND_CHANGED=false
          FRONTEND_CHANGED=false
          ANY_CHANGED=false

          while IFS= read -r file
          do

            [ -z "$file" ] && continue

            ANY_CHANGED=true

            case "$file" in

              source/backend/*)
                BACKEND_CHANGED=true
                ;;

              source/frontend/*)
                FRONTEND_CHANGED=true
                ;;

            esac

          done < <(
            {
              git diff --name-only
              git diff --name-only --cached
              git ls-files --others --exclude-standard
            } | sort -u
          )

          echo "any=$ANY_CHANGED" >> "$GITHUB_OUTPUT"
          echo "backend=$BACKEND_CHANGED" >> "$GITHUB_OUTPUT"
          echo "frontend=$FRONTEND_CHANGED" >> "$GITHUB_OUTPUT"

          echo "Any changes: $ANY_CHANGED"
          echo "Backend changes: $BACKEND_CHANGED"
          echo "Frontend changes: $FRONTEND_CHANGED"

      # =========================================================
      # RESTORE / BUILD BACKEND
      # =========================================================

      - name: Restore backend
        if: steps.changes.outputs.backend == 'true'
        shell: bash
        run: |
          dotnet restore \
            source/backend/BackAssistanceTravelers/BackAssistanceTravelers.sln

      - name: Build backend
        if: steps.changes.outputs.backend == 'true'
        shell: bash
        run: |
          dotnet build \
            source/backend/BackAssistanceTravelers/BackAssistanceTravelers.sln \
            --configuration Release \
            --no-restore

      # =========================================================
      # RESTORE / BUILD FRONTEND
      # =========================================================

      - name: Restore frontend
        if: steps.changes.outputs.frontend == 'true'
        shell: bash
        run: |
          dotnet restore \
            source/frontend/FrontAssistanceTravelers/FrontAssistanceTravelers.sln

      - name: Build frontend
        if: steps.changes.outputs.frontend == 'true'
        shell: bash
        run: |
          dotnet build \
            source/frontend/FrontAssistanceTravelers/FrontAssistanceTravelers.sln \
            --configuration Release \
            --no-restore

      # =========================================================
      # COMMIT
      # =========================================================

      - name: Commit changes
        if: steps.changes.outputs.any == 'true'
        shell: bash
        run: |

          git add -A

          git commit \
            -m "fix: implement issue #${ISSUE_NUMBER}"

          git push \
            -u origin \
            "$BRANCH_NAME"

      # =========================================================
      # PULL REQUEST
      # =========================================================

      - name: Create Pull Request
        id: pr
        if: steps.changes.outputs.any == 'true'

        env:
          GH_TOKEN: ${{ github.token }}
          CODEX_RESULT: ${{ steps.codex.outputs.final-message }}

        shell: bash

        run: |

          EXISTING_PR=$(gh pr list \
            --head "$BRANCH_NAME" \
            --base main \
            --state open \
            --json url \
            --jq '.[0].url')

          if [ -n "$EXISTING_PR" ]; then

            echo "Existing PR: $EXISTING_PR"

            echo "url=$EXISTING_PR" \
              >> "$GITHUB_OUTPUT"

            exit 0

          fi

          cat > /tmp/pr-body.md <<EOF
          ## 🤖 Implementado por Codex

          Resolves #${ISSUE_NUMBER}

          ### Resultado

          ${CODEX_RESULT}

          ### Validaciones automáticas

          Backend modificado:
          ${{ steps.changes.outputs.backend }}

          Frontend modificado:
          ${{ steps.changes.outputs.frontend }}

          Los proyectos afectados fueron compilados automáticamente
          antes de crear este Pull Request.

          ---

          Generado automáticamente mediante:

          \`@codex implement\`

          ⚠️ Requiere revisión humana antes del merge.
          EOF

          PR_URL=$(gh pr create \
            --base main \
            --head "$BRANCH_NAME" \
            --title "Fix #${ISSUE_NUMBER}: ${ISSUE_TITLE}" \
            --body-file /tmp/pr-body.md)

          echo "url=$PR_URL" \
            >> "$GITHUB_OUTPUT"

      # =========================================================
      # COMENTARIO EN ISSUE
      # =========================================================

      - name: Comment result on issue
        if: steps.changes.outputs.any == 'true'

        env:
          GH_TOKEN: ${{ github.token }}
          PR_URL: ${{ steps.pr.outputs.url }}

        shell: bash

        run: |

          cat > /tmp/issue-comment.md <<EOF

          🤖 **Codex terminó la implementación.**

          Rama:

          \`$BRANCH_NAME\`

          ### Validación

          Backend modificado:
          \`${{ steps.changes.outputs.backend }}\`

          Frontend modificado:
          \`${{ steps.changes.outputs.frontend }}\`

          Los proyectos afectados compilaron correctamente.

          ### Pull Request

          $PR_URL

          ⚠️ El código no fue fusionado automáticamente.

          Revisa el Pull Request antes del merge.

          EOF

          gh issue comment \
            "$ISSUE_NUMBER" \
            --body-file /tmp/issue-comment.md

      # =========================================================
      # SIN CAMBIOS
      # =========================================================

      - name: Comment when no changes were produced
        if: steps.changes.outputs.any == 'false'

        env:
          GH_TOKEN: ${{ github.token }}
          CODEX_RESULT: ${{ steps.codex.outputs.final-message }}

        shell: bash

        run: |

          cat > /tmp/comment.md <<EOF

          🤖 **Codex analizó la issue pero no generó cambios.**

          ${CODEX_RESULT}

          EOF

          gh issue comment \
            "$ISSUE_NUMBER" \
            --body-file /tmp/comment.md
