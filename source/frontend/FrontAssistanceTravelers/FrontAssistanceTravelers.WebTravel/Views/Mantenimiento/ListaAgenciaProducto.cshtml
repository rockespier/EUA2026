@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity).FindFirst("PaginaDashboard").Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.col {
		display: flex;
		flex-direction: column;
		align-content: flex-start;
		align-items: center;
	}

	.loading-state {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.3);
		z-index: 9999;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.loader {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		display: inline-block;
		position: relative;
		border: 3px solid;
		border-color: #FFF #FFF transparent;
		box-sizing: border-box;
		animation: rotation 1s linear infinite;
	}

		.loader::after {
			content: '';
			box-sizing: border-box;
			position: absolute;
			left: 0;
			right: 0;
			top: 0;
			bottom: 0;
			margin: auto;
			border: 3px solid;
			border-color: transparent #FF3D00 #FF3D00;
			width: 24px;
			height: 24px;
			border-radius: 50%;
			animation: rotationBack 0.5s linear infinite;
			transform-origin: center center;
		}

	@@keyframes rotation {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

	@@keyframes rotationBack {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(-360deg);
		}
	}

	.typeahead {
		width: 100%;
		padding: 0.375rem 0.75rem;
		border: 1px solid #ced4da;
		border-radius: 0.25rem;
	}
</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Descuentos</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Mantenimientos</li>
						<li class="breadcrumb-item active">Descuentos</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div style="display:none" name="cargar" id="cargar" class="loading-state">
		<div class="loader"></div>
	</div>
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<div class="row">
								<div class="col-sm-1 col-6">
									<div class="mb-3">
										<label class="form-label" for="mdSelPais">Pais:</label>
									</div>
								</div>
								<div class="col-sm-3 col-6">
									<div class="mb-3">
										<select class="form-select" id="mdSelPais" name="mdSelPais">
										</select>
									</div>
								</div>
								
								<div class="col-sm-4 col-6">
									<div class="mb-3">
										<a href="javascript:void(0);" onclick="BuscarLista();" class="btn btn-primary mb-3">
											<span class="glyphicon glyphicon-plus"></span> Buscar
										</a>
										<a href="javascript:void(0);" onclick="AbrirModal(0);"
										   class="btn btn-primary mb-3">
											<span class="glyphicon glyphicon-plus"></span> Agregar nuevo descuento
										</a>
									</div>
								</div>
							</div>
						</p>
						<div class="table-responsive">
							<table class="display" id="dtProductos">
								<thead>
									<tr>										
										<th>Producto</th>										
										<th>Agencia</th>
										<th>Desde</th>
										<th>Hasta</th>
										<th>Descuento</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- Container-fluid Ends-->
	<div class="modal fade bd-example-modal-lg" id="popupModalUsuario" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModal" name="tituloModal" class="modal-title"></h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="modalUsuario" name="modalUsuario" action="">
					<input id="mdHidId" name="mdHidId" type="hidden" />
					<div class="modal-body">
						<div class="card">
							<div class="card-body">
								<div class="row">
									<div class="col-sm-12">
										<div class="mb-3">
											<label class="form-label">Agencia</label>
											<input type="text" class="form-select form-control-sm typeahead" id="txtAgencia" placeholder="---Buscar Agencia---" name="txtAgencia" />
										</div>
									</div>
									<div class="col-sm-12">
										<div class="mb-3">
											<label class="form-label">Producto</label>
											<select class="form-select" id="mdselProducto" name="mdselProducto">
											</select>
										</div>
									</div>
									<div class="col-sm-12">
										<div class="mb-3">
											<label class="form-label">Nombre del descuento <span class="req">*</span></label>
											<input type="text" class="form-select form-control-sm" id="txtagenciaProductoDescuentoNombre" placeholder="" name="txtagenciaProductoDescuentoNombre" />
										</div>
									</div>
									<div class="col-sm-4">
										<div class="mb-3">
											<label class="form-label">Descuento (%) <span class="req">*</span></label>
											<input class="form-control" id="mdtxtDescuento" name="mdtxtDescuento" type="number" min="1" max="100">
										</div>
									</div>							
									<div class="col-sm-4">
										<div class="mb-3">
											<label class="form-label">Desde <span class="req">*</span></label>
											<input type="date" class="form-control" id="mdvenFecIncioVig" name="mdvenFecIncioVig">
										</div>
									</div>
									<div class="col-sm-4">
										<div class="mb-3">
											<label class="form-label">Hasta <span class="req">*</span></label>
											<input type="date" class="form-control" id="mdvenFecFinalVig" name="mdvenFecFinalVig">
										</div>
									</div>

								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
						<button class="btn btn-primary" id="Guardar" name="Guardar" onclick="clickValidar();" type="button">Grabar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Script {
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>

	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="~/assets/js/typeahead/typeahead.bundle.js"></script>

	<script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
	<script src="../assets/js/datatable/datatables/datatable.custom.js?v=2"></script>
	<script src="~/assets/js/datatable/datatable-extension/datatables.fixedheader.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/moment.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/daterangepicker.js"></script>s

	
	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.55"></script>
	<script src="~/travel/ListaAgenciaProducto.js?v=1.86"></script>
}


