@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity).FindFirst("PaginaDashboard").Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		padding: 0.5rem 0.5rem;
		margin-left: 55rem;
	}

	.derecha {
		box-sizing: content-box;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}
</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Tipos de Solicitud</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Mantenimiento</li>
						<li class="breadcrumb-item active">Tipos de Solicitud</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<a href="javascript:void(0);" onclick="AbrirModal(0);"
							   class="btn btn-primary mb-3">
								<span class="glyphicon glyphicon-plus"></span> Agregar nuevo tipo de solicitud
							</a>
						</p>
						<div class="table-responsive">
							<table class="display" id="dtTipoSolicitud">
								<thead>
									<tr>
										<th>Id</th>
										<th>Acción</th>										
										<th>Descripción</th>
										<th>Envia correo?</th>										
										<th>Estado</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- Container-fluid Ends-->
	<div class="modal fade bd-example-modal-xl" id="popupSolicitudTipo" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModal" name="tituloModal" class="modal-title"></h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="frmSolicitudTipo" name="frmSolicitudTipo" action="">
					<div class="modal-body">
						<div class="card">
							<div class="card-body">
								<div class="row">
									<div class="col-sm-12 col-6-4">
										<div class="mb-3">
											<label class="form-label">Acción</label>
											<select class="form-select" id="mdselAccion" name="mdselAccion">
											</select>
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Descripcion</label>
											<input class="form-control" type="text" id="mdtxtNombreCompleto" name="mdtxtNombreCompleto" placeholder="Nombre Completo" aria-required="true">
										</div>
									</div>
									<div class="col-sm-12 col-6-2">
										<div class="mb-3">
											<label class="form-label">Enviar Correo</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" checked="" id="mdchkCorreo" name="mdchkCorreo" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div>
									<div class="col-sm-12 col-6-2">
										<div class="mb-3">
											<label class="form-label">Estado</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" checked="" id="mdchkEstado" name="mdchkEstado" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div>
									
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
						<button class="btn btn-primary" id="Guardar" name="Guardar" onclick="clickValidar();" type="button">Grabar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Script {
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>

	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="../assets/js/select2/select2.full.min.js"></script>
	<script src="../assets/js/select2/select2-custom.js"></script>
	<script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
	<script src="../assets/js/datatable/datatables/datatable.custom.js?v=2"></script>
	<script src="~/assets/js/datatable/datatable-extension/datatables.fixedheader.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/moment.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/daterangepicker.js"></script>s


	<script src="../assets/js/dropzone/dropzone.js"></script>
	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.55"></script>
	<script src="~/travel/solicitudtipo.js?v=1.11"></script>
}


