@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity!).FindFirst("PaginaDashboard")!.Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.action {
		display: flex;
		justify-content: center; /* Center horizontally */
		align-items: center; /* Center vertically */
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		margin-left: 35rem;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}

	.grid-divider {
		overflow-x: hidden;
		position: relative;
	}

		.grid-divider > [class*="col-"]:nth-child(n + 2):after {
			content: "";
			background-color: black;
			position: absolute;
			top: 0;
			bottom: 0;

			@@media (max-width: 767px) {
				width: 100%;
				height: 1px;
				left: 0;
				top: -4px;
			}

			@@media (min-width: 768px) {
				width: 1px;
				height: auto;
				left: -1px;
			}
		}

	#globalLoader {
		display: none; /* Initially hidden */
		position: fixed; /* Fixed to cover entire screen */
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
		z-index: 9999; /* Ensure it's on top */
		justify-content: center;
		align-items: center;
	}

	.spinner {
		border: 4px solid #f3f3f3; /* Light grey */
		border-top: 4px solid #3498db; /* Blue */
		border-radius: 50%;
		width: 50px;
		height: 50px;
		animation: spin 2s linear infinite;
	}


	@@keyframes spin {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

	.typeahead {
		width: 100%;
		padding: 0.375rem 0.75rem;
		border: 1px solid #ced4da;
		border-radius: 0.25rem;
	}

	.dt-button-collection .dropdown-menu {
		display: block;
		position: static;
		float: none;
	}

	.dt-button {
		margin-right: 5px;
	}

	.edades .form-control {
		padding-left: 0px;
		padding-right: 0px;
		text-align: center;
	}

	.box-form .btn-calculadora {
		padding: 0;
		border: 0;
		background: transparent;
		color: #f09000;
		font-size: 10px;
		font-weight: bold;
	}

	.box-form .btn-success {
		background: #f09000;
		border-color: #f09000;
	}

	.modal-header #estadoModalVenta {
		margin-left: 3rem;
		/*float:right;*/
	}
</style>
