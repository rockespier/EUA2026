									</select>
								</div>
							</div>
							<hr />
							<div class="row">
								<div class="row">
									<div class="col-sm-6 col-6-6">
										<div class="mb-3">
											<label class="form-label">Metodo Pago <span class="req">*</span></label>
											<select id="mdvenSelMetodoDetLiquiCance" name="mdvenSelMetodoDetLiquiCance" class="form-select form-select-sm">
											</select>
										</div>
									</div>
									<div class="col-sm-6 col-6-3">
										<div class="mb-3">
											<label class="form-label">Monto Pago <span class="req">*</span></label>
											<input class="form-control form-control-sm" type="number" id="mdvenTxtPagoDetLiquiCance" step="0.01" min="0" name="mdvenTxtPagoDetLiquiCance" placeholder="">
										</div>
									</div>
									<div class="col-sm-6 col-6-3">
										<div class="mb-3">
											<label class="form-label">Fecha Pago <span class="req">*</span></label>
											<input type="date" class="form-control form-control-sm" id="mdvenFecPagoDetLiquiCance" name="mdvenFecPagoDetLiquiCance">
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-sm-6 col-6-6">
										<div class="mb-3">
											<label class="form-label">Archivo <span class="req">*</span></label>
											<div class="input-group">
												<input type="file" class="form-control form-control-sm" id="mdvenFilePagoDetLiquiCance" name="mdvenFilePagoDetLiquiCance" accept="image/png, image/gif, image/jpeg, application/pdf, video/mp4,video/x-m4v,video/*" aria-describedby="mdBotOtEvidencia" aria-label="Upload">
											</div>
										</div>
									</div>
									<div class="col-sm-6 col-6-5">
										<div class="mb-3">
											<label class="form-label">Observación</label>
											<input type="text" class="form-control form-control-sm" id="mdvenTxtObservaDetLiquiCance" name="mdvenTxtObservaDetLiquiCance">
										</div>
									</div>
									<div class="col-sm-6 col-6-1" style="text-align: center">
										<div class="mt-4 ">
											<button class="btn btn-primary" type="button" id="mdvenBtnAgregarPago" onclick="clickValidarPasajero();" name="mdvenBtnAgregarPago">
												<i class="fa fa-plus" title="agregar pago"></i>
											</button>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col">
										<div class="table-responsive user-datatable">
											<table class="display" id="dtDetallePago" name="dtDetallePago">
												<thead>
													<tr>
														<th>Metodo</th>
														<th>Importe</th>
														<th>Observación</th>
														<th>Fecha</th>
														<th>Adjunto</th>
														<th>Estado</th>
														<th>Acciones</th>
													</tr>
												</thead>
											</table>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" id="btnCerrarCancelar" name="btnCerrarCancelar" data-bs-dismiss="modal">Cerrar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
	<!-- popup Venta Cancelar-->
