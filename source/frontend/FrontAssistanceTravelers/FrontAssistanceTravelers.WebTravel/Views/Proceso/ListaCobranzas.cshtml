@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity!).FindFirst("PaginaDashboard")!.Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.action {
		display: flex;
		justify-content: center; /* Center horizontally */
		align-items: center; /* Center vertically */
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		margin-left: 35rem;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}

	.grid-divider {
		overflow-x: hidden;
		position: relative;
	}

		.grid-divider > [class*="col-"]:nth-child(n + 2):after {
			content: "";
			background-color: black;
			position: absolute;
			top: 0;
			bottom: 0;

			@@media (max-width: 767px) {
				width: 100%;
				height: 1px;
				left: 0;
				top: -4px;
			}

			@@media (min-width: 768px) {
				width: 1px;
				height: auto;
				left: -1px;
			}
		}

	#globalLoader {
		display: none; /* Initially hidden */
		position: fixed; /* Fixed to cover entire screen */
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
		z-index: 9999; /* Ensure it's on top */
		justify-content: center;
		align-items: center;
	}

	.spinner {
		border: 4px solid #f3f3f3; /* Light grey */
		border-top: 4px solid #3498db; /* Blue */
		border-radius: 50%;
		width: 50px;
		height: 50px;
		animation: spin 2s linear infinite;
	}


	@@keyframes spin {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/datatables.datatables.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/fixedcolumns.datatables.css" rel="stylesheet" />
<link href="~/assets/css/vendors/select.datatables.css" rel="stylesheet" />
<div class="page-body">
	<div id="globalLoader" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
		<div class="spinner"></div>
		<span style="margin-top: 10px; font-family: sans-serif; font-size: 16px; color: white; font-weight: bold;">Cargando...</span>
	</div>
	<div class="container-fluid">
		<input id="mdHidIdVentaTarjeta" name="mdHidIdVentaTarjeta" type="hidden" />
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Registro de Pagos</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Operaciones</li>
						<li class="breadcrumb-item active">Registro de Pagos</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<!--Filtros-->
							<a href="javascript:void(0);" onclick="AbrirModalBusqueda();" class="btn btn-dark mb-3" id="lnkNueva" name="lnkNueva">
								<i class="fa fa-binoculars"></i>  Busqueda Avanzada
							</a>
							<a href="javascript:void(0);" class="btn btn-dark mb-3" id="btnExport" name="btnExport">
								<i class="fa fa-excel"></i>  Exportar
							</a>
						</p>
						<div class="table-responsive user-datatable">
							<table class="display" id="dtCobranza">
								<thead>
									<tr>
										<th>Documento</th>
										<th>Cliente</th>
										<th>Imp. Bruto</th>
										<th>Imp. Comisión</th>
										<th>Imp. Incentivo</th>
										<th>Monto Pago</th>										
										<th>Fecha Pago</th>
										<th>Cobrador</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- popup Venta Busqueda-->
	<div class="modal fade bd-example-modal-l" id="popupModalVentaSearch" data-bs-backdrop="static" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-l" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModalVentaSearch" name="tituloModalVentaSearch" class="modal-title"></h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="modalDatosVentaSearch" name="modalDatosVentaSearch" action="">
					<div class="modal-body">
						<div class="card-body">
							<div class="row">
								<div class="col-sm-12 col-12">
									<div class="mb-2">
										<label class="form-label">Cod. Liquidación:</label>
										<input type="text" class="form-control form-control-sm" id="mdCodLiquidacion" name="mdCodLiquidacion">
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-6 col-6-6">
									<div class="mb-2">
										<label class="form-label">Ingresado el:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecIncioVigSearch" name="mdvenFecIncioVigSearch">
									</div>
								</div>
								<div class="col-sm-6 col-6-6">
									<div class="mb-2">
										<label class="form-label">Hasta:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecFinalVigSearch" name="mdvenFecFinalVigSearch">
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-6 col-6-6">
									<div class="mb-2">
										<label class="form-label">Pagado el:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecIncioPagoSearch" name="mdvenFecIncioPagoSearch">
									</div>
								</div>
								<div class="col-sm-6 col-6-6">
									<div class="mb-2">
										<label class="form-label">Hasta:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecFinalPagoSearch" name="mdvenFecFinalPagoSearch">
									</div>
								</div>
							</div>

						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-info" type="button" id="btnLimpiarBsq" name="btnLimpiarBsq" onclick="clickBuscarLimpiar();">
							<i class="fa fa-eraser"></i>  Limpiar
