								</div>

								<div class="col-sm-6 col-6-3">
									<label for="mdvenFecPagooLiquiCance">Fecha pago</label>
									<input type="date" class="form-control form-control-sm" id="mdvenFecPagooLiquiCance" name="mdvenFecPagooLiquiCance" readonly>
								</div>

								<div class="col-sm-6 col-6-3">
									<label for="mdvenSelCobradorLiquiCance">Cobrador</label>
