						<div class="card-body">
							<div class="row">
								<div class="col-sm-6 col-6-6">
									<label for="mdvenSelTipoLiquiCance">Tipo Documento</label>
									<select id="mdvenSelTipoLiquiCance" name="mdvenSelTipoLiquiCance" class="form-select form-select-sm" disabled="true">
