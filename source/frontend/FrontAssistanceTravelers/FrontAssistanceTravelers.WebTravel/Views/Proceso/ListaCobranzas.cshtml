									<input type="text" class="form-control form-control-sm" id="mdvenTxtClieLiquiCance" name="mdvenTxtClieLiquiCance" readonly>
								</div>
								<div class="col-sm-6 col-6-3">
									<label for="mdvenTxtImpBrutoLiquiCance">Imp. Bruto</label>
									<input type="text" class="form-control form-control-sm" id="mdvenTxtImpBrutoLiquiCance" readonly>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-6 col-6-3">
									<label for="mdvenTxtComisionLiquiCance">Comisión</label>
