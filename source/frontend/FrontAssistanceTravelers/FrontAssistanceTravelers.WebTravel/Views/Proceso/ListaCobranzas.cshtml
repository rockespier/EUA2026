								</div>
								<div class="col-sm-6 col-6-3">
									<label for="mdvenTxtImpPagoLiquiCance">Imp. Pago</label>
									<input type="text" class="form-control form-control-sm" id="mdvenTxtImpPagoLiquiCance" readonly>
								</div>
							</div>
							<div class="row">
