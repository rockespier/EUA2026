                                        <th>Saldo</th><!--9-->
                                        <th>Comisión</th><!--10-->
                                        <th>Incentivo</th><!--11-->
                                        <th>Publicidad</th><!--12-->
                                        <th>Descuento</th><!--13-->
                                        <th>Total</th><!--14-->
                                        <th>Observaciones</th><!--15-->
                                        <th>Medio Pago</th><!--16-->
                                        <th>Id</th><!--17-->
