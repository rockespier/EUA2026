@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity!).FindFirst("PaginaDashboard")!.Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.action {
		display: flex;
		justify-content: center; /* Center horizontally */
		align-items: center; /* Center vertically */
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		margin-left: 35rem;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}

	.grid-divider {
		overflow-x: hidden;
		position: relative;
	}

		.grid-divider > [class*="col-"]:nth-child(n + 2):after {
			content: "";
			background-color: black;
			position: absolute;
			top: 0;
			bottom: 0;

			@@media (max-width: 767px) {
				width: 100%;
				height: 1px;
				left: 0;
				top: -4px;
			}

			@@media (min-width: 768px) {
				width: 1px;
				height: auto;
				left: -1px;
			}
		}

	#globalLoader {
		display: none; /* Initially hidden */
		position: fixed; /* Fixed to cover entire screen */
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
		z-index: 9999; /* Ensure it's on top */
		justify-content: center;
		align-items: center;
	}

	.spinner {
		border: 4px solid #f3f3f3; /* Light grey */
		border-top: 4px solid #3498db; /* Blue */
		border-radius: 50%;
		width: 50px;
		height: 50px;
		animation: spin 2s linear infinite;
	}


	@@keyframes spin {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

	.typeahead {
		width: 100%;
		padding: 0.375rem 0.75rem;
		border: 1px solid #ced4da;
		border-radius: 0.25rem;
	}

	.dt-button-collection .dropdown-menu {
		display: block;
		position: static;
		float: none;
	}

	.dt-button {
		margin-right: 5px;
	}

</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/datatables.datatables.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/fixedcolumns.datatables.css" rel="stylesheet" />
<link href="~/assets/css/vendors/select.datatables.css" rel="stylesheet" />
<div class="page-body">
	<div id="globalLoader" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
		<div class="spinner"></div>
		<span style="margin-top: 10px; font-family: sans-serif; font-size: 16px; color: white; font-weight: bold;">Cargando...</span>
	</div>
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Resumen de Cobranzas</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Reportes</li>
						<li class="breadcrumb-item active">Resumen de Cobranzas</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<form id="modalDatosVentaResRep" name="modalDatosVentaResRep" action="">
							<div class="row">
								<div class="col-3">
									<div class="mb-3">
										<label class="form-label" for="mdvenFecIni">Fecha Inicio<span class="req">*</span></label>
										<input type="date" class="form-control" id="mdvenFecIni" name="mdvenFecIni">
									</div>
								</div>
								<div class="col-3">
									<div class="mb-3">
										<label class="form-label" for="mdvenFecFin">Fecha Fin<span class="req">*</span></label>
										<input type="date" class="form-control" id="mdvenFecFin" name="mdvenFecFin">
									</div>
								</div>
								<div class="col-3">
									<div class="mb-3">
										<label class="form-label" for="txtCodLiquidacion">Cod. Liquidación</label>
										<input class="form-control" id="txtCodLiquidacion" name="txtCodLiquidacion" />
									</div>
								</div>
								<div class="col-3">
									<div class="mb-3" style="margin-top:38px">
										<a href="javascript:void(0);" onclick="exportaReporteResumen();" class="btn btn-dark mb-3" id="btnExport" name="btnExport">
											<i class="fa fa-excel"></i>  Generar Resumen
										</a>
									</div>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>

	
</div>
