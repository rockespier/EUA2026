@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity!).FindFirst("PaginaDashboard")!.Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	#globalLoader {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		z-index: 9999;
		justify-content: center;
		align-items: center;
	}

	.spinner {
		border: 4px solid #f3f3f3;
		border-top: 4px solid #3498db;
		border-radius: 50%;
		width: 50px;
		height: 50px;
		animation: spin 2s linear infinite;
	}

	@@keyframes spin {
		0% {
			transform: rotate(0deg);
		}

		100% {
			transform: rotate(360deg);
		}
	}

	.typeahead {
		width: 100%;
		padding: 0.375rem 0.75rem;
		border: 1px solid #ced4da;
		border-radius: 0.25rem;
	}

	#panelColumnasVenta .form-check {
		margin-bottom: 0.35rem;
	}

	#panelColumnasVenta h6 {
		margin-top: 0.75rem;
		font-weight: bold;
	}
</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/datatables.datatables.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/fixedcolumns.datatables.css" rel="stylesheet" />
<div class="page-body">
	<div id="globalLoader" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
		<div class="spinner"></div>
		<span style="margin-top: 10px; font-family: sans-serif; font-size: 16px; color: white; font-weight: bold;">Cargando...</span>
	</div>
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Reporte Personalizado de Ventas</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Reportes</li>
						<li class="breadcrumb-item active">Reporte Personalizado de Ventas</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<!--Filtros y acciones-->
							<a href="javascript:void(0);" onclick="AbrirModalBusqueda();" class="btn btn-dark mb-3" id="lnkNueva" name="lnkNueva">
								<i class="fa fa-binoculars"></i>  Busqueda Avanzada
							</a>
							<a href="javascript:void(0);" onclick="AbrirModalColumnas();" class="btn btn-info mb-3" id="btnColumnas" name="btnColumnas">
								<i class="fa fa-columns"></i>  Seleccionar Columnas
							</a>
							<a href="javascript:void(0);" class="btn btn-dark mb-3" id="btnExport" name="btnExport">
								<i class="fa fa-excel"></i>  Exportar Excel
							</a>
							<a href="javascript:void(0);" class="btn btn-danger mb-3" id="btnExportPdf" name="btnExportPdf">
								<i class="fa fa-file-pdf-o"></i>  Exportar PDF
							</a>
						</p>
						<div class="table-responsive user-datatable">
							<table class="display" id="dtVenta" style="width:100%"></table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- popup Venta Busqueda-->
	<div class="modal fade bd-example-modal-l" id="popupModalVentaSearch" data-bs-backdrop="static" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-l" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModalVentaSearch" name="tituloModalVentaSearch" class="modal-title">Busqueda Avanzada</h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="modalDatosVentaSearch" name="modalDatosVentaSearch" action="">
					<div class="modal-body">
						<div class="card-body">
							<div class="row">
								<div class="col-sm-6 ">
									<div class="mb-2">
										<label class="form-label">Ingresado el:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecIncioVigSearch" name="mdvenFecIncioVigSearch">
									</div>
								</div>
								<div class="col-sm-6 ">
									<div class="mb-2">
										<label class="form-label">Hasta:</label>
										<input type="date" class="form-control form-control-sm" id="mdvenFecFinalVigSearch" name="mdvenFecFinalVigSearch">
									</div>
								</div>
							</div>
							<div class="row" name="divVenSelPaisSearch" id="divVenSelPaisSearch">
								<div class="col-sm-12 col-6-12">
									<div>
										<label class="form-label" for="mdvenSelPaisSearch">País:</label>
										<select class="form-select form-select-sm" id="mdvenSelPaisSearch" name="mdvenSelPaisSearch">
										</select>
									</div>
								</div>
							</div>
							<div class="row" name="divVenSelAgenciaSearch" id="divVenSelAgenciaSearch">
								<div class="col-sm-12 col-6-12">
									<div>
										<label class="form-label" for="txtAgencia">Agencia:</label>
										<input type="text" class="form-select form-control-sm typeahead" id="txtAgencia" placeholder="---Buscar Agencia---" name="txtAgencia" />
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-12 col-6-12">
									<div>
										<label class="form-label" for="mdvenSelEstadoSearch">Estado:</label>
										<select class="form-select form-select-sm" id="mdvenSelEstadoSearch" name="mdvenSelEstadoSearch">
										</select>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-12 col-6-12">
									<div>
										<label class="form-label" for="mdvenSelSituacionSearch">Situación:</label>
										<select class="form-select form-select-sm" id="mdvenSelSituacionSearch" name="mdvenSelSituacionSearch">
										</select>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-info" type="button" id="btnLimpiarBsq" name="btnLimpiarBsq" onclick="clickBuscarLimpiar();">
							<i class="fa fa-eraser"></i>  Limpiar
						</button>
						<button class="btn btn-primary" type="button" id="btnBuscarVentas" name="btnBuscarVentas" onclick="clickBuscarVentas();">
							<i class="fa fa-search"></i>  Buscar
						</button>
						<button class="btn btn-secondary" type="button" id="btnCerrarSearch" name="btnCerrarSearch" data-bs-dismiss="modal">Cerrar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
	<!-- popup Venta Busqueda-->

	<!-- popup Seleccion de Columnas-->
	<div class="modal fade bd-example-modal-l" id="popupModalColumnas" data-bs-backdrop="static" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-l" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModalColumnas" class="modal-title">Seleccionar Columnas del Reporte</h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="card-body">
						<div class="form-check mb-3">
							<input class="form-check-input" type="checkbox" id="chkColumnasTodas" name="chkColumnasTodas">
							<label class="form-check-label" for="chkColumnasTodas"><strong>Seleccionar / Deseleccionar todas</strong></label>
						</div>
						<div id="panelColumnasVenta" style="max-height: 55vh; overflow-y: auto;"></div>
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-primary" type="button" id="btnAplicarColumnas" name="btnAplicarColumnas" onclick="clickAplicarColumnas();">
						<i class="fa fa-check"></i>  Generar Reporte
					</button>
					<button class="btn btn-secondary" type="button" id="btnCerrarColumnas" name="btnCerrarColumnas" data-bs-dismiss="modal">Cerrar</button>
				</div>
			</div>
		</div>
	</div>
	<!-- popup Seleccion de Columnas-->

</div>
@section Script {
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>
	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="~/assets/js/typeahead/typeahead.bundle.js"></script>

	<script src="~/assets/js/datatable/datatablesv2/datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/datatables.fixedcolumns.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/fixedcolumns.datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/datatables.select.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/select.datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/dataTables.buttons.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.dataTables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/jszip.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/pdfmake.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/vfs_fonts.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.html5.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.print.min.js"></script>

	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>
	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.56"></script>
	<script src="~/travel/ReportePersonalizadoVentas.js?v=1.0"></script>

}
