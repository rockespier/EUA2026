@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity).FindFirst("PaginaDashboard").Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		padding: 0.5rem 0.5rem;
		margin-left: 55rem;
	}

	.derecha {
		box-sizing: content-box;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}
</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Paises</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Seguridad</li>
						<li class="breadcrumb-item active">Paises</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<a href="javascript:void(0);" onclick="AbrirModal(0);"
							   class="btn btn-primary mb-3">
								<span class="glyphicon glyphicon-plus"></span> Agregar nuevo país
							</a>
						</p>
						<div class="table-responsive">
							<table class="display" id="dtPaises">
								<thead>
									<tr>
										<th>Id</th>
										<th>Nombre</th>
										<th>Correo</th>
										<th>Promotor</th>
										<th>Impuesto Venta</th>
										<th>Estado</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- Container-fluid Ends-->
	<div class="modal fade bd-example-modal-xl" id="popupModalPais" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModal" name="tituloModal" class="modal-title"></h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="frmModalPais" name="frmModalPais" action="">
					<div class="modal-body">
						<div class="card">
							<div class="card-body">
								<div class="row">
									<div class="col-sm-5 ">
										<div class="mb-3">
											<label class="form-label">Nombre </label>
											<input class="form-control" type="text" id="mdtxtNombreCompleto" name="mdtxtNombreCompleto" placeholder="Nombre" aria-required="true">
										</div>
									</div>
									<div class="col-sm-5">
										<div class="mb-3">
											<label class="form-label">Correo</label>
											<input class="form-control" type="email" id="mdtxtCorreo" name="mdtxtCorreo" placeholder="Correo">
										</div>
									</div>
									<div class="col-sm-2">
										<div class="mb-3">
											<label class="form-label">Estado</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" checked="" id="mdchkEstado" name="mdchkEstado" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div>
									@* <div class="col-sm-12">
										<div class="mb-3">
											<label class="form-label">Paga 100%?</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" checked="" id="mdchkTotalPago" name="mdchkTotalPago" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div> *@
									<div class="col-sm-3">
										<div class="mb-4">
											<label class="form-label">Promotor</label>
											<select class="form-select digits" id="mdselPromotor" name="mdselPromotor">
											</select>
										</div>
									</div>
									<div class="col-sm-3">
										<div class="mb-4">
											<label class="form-label">Pais Impuesto</label>
											<input class="form-control" type="text" id="mdtxtImpuestoPais" name="mdtxtImpuestoPais">
										</div>
									</div>
									<div class="col-sm-3">
										<div class="mb-4">
											<label class="form-label">Impuesto Venta</label>
											<input class="form-control" type="text" id="mdtxtImpuestoVenta" name="mdtxtImpuestoVenta">
										</div>
									</div>
																		
									<div class="col-sm-3">
										<div class="mb-3">
											<label class="form-label">Formato Voucher</label>
											<select class="form-select digits" id="mdselFormatoVoucher" name="mdselFormatoVoucher">
											</select>
										</div>
									</div>

									
									
									
									<div class="col-sm-12">
										<div>
											<label class="form-label">Datos EUA</label>
											<textarea class="form-control" rows="4" id="mdtxtComentarios" name="mdtxtComentarios" placeholder="Ingrese alguna descripción sobre el país."></textarea>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
						<button class="btn btn-primary" id="Guardar" name="Guardar" onclick="clickValidar();" type="button">Grabar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Script {
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>

	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="../assets/js/select2/select2.full.min.js"></script>
	<script src="../assets/js/select2/select2-custom.js"></script>
	<script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
	<script src="../assets/js/datatable/datatables/datatable.custom.js?v=2"></script>
	<script src="~/assets/js/datatable/datatable-extension/datatables.fixedheader.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/moment.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/daterangepicker.js"></script>s


	<script src="../assets/js/dropzone/dropzone.js"></script>
	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.55"></script>
	<script src="~/travel/pais.js?v=1.17"></script>
}


