@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity).FindFirst("PaginaDashboard").Value;
}
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />

<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Perfiles</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Seguridad</li>
						<li class="breadcrumb-item active">Perfiles</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">

					<div class="card-body">
						<p>
							<a href="javascript:void(0);" onclick="AbrirModal(0);"
							   class="btn btn-primary mb-3">
								<span class="glyphicon glyphicon-plus"></span> Agregar nuevo perfil
							</a>
						</p>
						<div class="table-responsive">
							<table class="display" id="dtPerfiles">
								<thead>
									<tr>
										<th>Codigo</th>
										<th>Nombre</th>										
										<th>Usuarios</th>
										<th>Registro</th>
										<th>Estado</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- Container-fluid Ends-->
	<div class="modal fade bd-example-modal-xl" id="ModalPerfil" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="ModalPerfil" aria-hidden="true">
		<div class="modal-dialog modal-xl" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="tituloModal" name="tituloModal">Actualizar Perfil</h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<form id="frmModalPerfil" name="frmModalPerfil" action="">
						<div class="card-body">
							<div class="row">
								<div class="col-sm-10 col-6-10">
									<div class="mb-3">
										<label class="form-label">Nombre</label>
										<input class="form-control" type="text" placeholder="Nombre" id="mdtxtNombreCompleto" name="mdtxtNombreCompleto" aria-required="true">
									</div>
								</div>
								<div class="col-sm-12 col-6-2">
									<div class="mb-3">
										<label class="form-label">Estado</label>
										<div class="media-body text-start icon-state">
											<label class="switch">
												<input type="checkbox" checked="" id="mdchkEstado" name="mdchkEstado" wfd-id="id8"><span class="switch-state"></span>
											</label>
										</div>
									</div>
								</div>
							</div>
						</div>
					</form>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
					<button class="btn btn-primary" id="Guardar" name="Guardar" onclick="clickValidar();" type="button">Grabar</button>
				</div>
			</div>
		</div>
	</div>
</div>
@section Script {
	<!-- Plugins JS start-->
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js?v1.72"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>

	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
	<script src="../assets/js/datatable/datatables/datatable.custom.js"></script>
	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>
	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.55"></script>
	<script src="~/travel/Perfil.js?v=10.23"></script>
	}



