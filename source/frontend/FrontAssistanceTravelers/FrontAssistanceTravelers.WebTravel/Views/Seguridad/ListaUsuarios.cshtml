@using System.Security.Claims;
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	var indexDashluser = ((ClaimsIdentity)User.Identity).FindFirst("PaginaDashboard").Value;
}
<style>
	.tab-content > .tab-pane {
		padding-top: 70px !important;
	}

	div .action {
		position: static !important;
	}

	.btn {
		padding: 0.375rem 0.75rem !important;
		font-size: 1rem !important;
	}

	.modal-title {
		white-space: nowrap;
	}

	.modal-header .derecha {
		padding: 0.5rem 0.5rem;
		margin-left: 55rem;
	}

	.derecha {
		box-sizing: content-box;
	}

	.form-switch .form-check-input {
		width: 3em;
		height: 2em;
	}
</style>
<link href="~/assets/css/vendors/jquery-ui.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/datatables.datatables.css" rel="stylesheet" />
<link href="~/assets/css/datatablev2/fixedcolumns.datatables.css" rel="stylesheet" />
<link href="~/assets/css/vendors/select.datatables.css" rel="stylesheet" />
<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h3>Usuarios</h3>
				</div>
				<div class="col-6">
					<ol class="breadcrumb">
						<li class="breadcrumb-item">
							<a asp-controller="Dashboard" asp-action="@indexDashluser">
								<svg class="stroke-icon">
									<use href="/assets/svg/icon-sprite.svg#stroke-home"></use>
								</svg>
							</a>
						</li>
						<li class="breadcrumb-item">Seguridad</li>
						<li class="breadcrumb-item active">Usuarios</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<!-- Container-fluid starts-->
	<div class="container-fluid">
		<div class="row">
			<!-- State saving Starts-->
			<div class="col-sm-12">
				<div class="card">
					<div class="card-body">
						<p>
							<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap">
								<a href="javascript:void(0);" onclick="AbrirModal(0);" class="btn btn-primary me-3 mb-2">
									<span class="glyphicon glyphicon-plus"></span> Agregar nuevo usuario
								</a>
								<div class="d-flex align-items-center">
									<label class="form-label me-2 mb-0">Solo Activos:</label>
									<div class="media-body text-start icon-state">
										<label class="switch mb-0">
											<input type="checkbox" checked="checked" id="mdchkActivos" name="mdchkActivos"><span class="switch-state"></span>
										</label>
									</div>
								</div>
							</div>
						</p>
						<div class="table-responsive">
							<table class="display" id="dtUsuarios">
								<thead>
									<tr>
										<th>Login</th>
										<th>Nombre</th>
										<th>País</th>
										<th>Perfil</th>
										<th>Correo</th>
										<th>Valido desde</th>
										<th>Estado</th>
										<th>Acciones</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
			<!-- State saving Ends-->
		</div>
	</div>
	<!-- Container-fluid Ends-->
	<div class="modal fade bd-example-modal-xl" id="popupModalUsuario" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" >
		<div class="modal-dialog modal-xl" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 id="tituloModal" name="tituloModal" class="modal-title"></h5>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="modalUsuario" name="modalUsuario" action="">
					<div class="modal-body">
						<div class="card">
							<div class="card-body">
								<div class="row">
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Nombre Completo <span class="req">*</span></label>
											<input class="form-control" type="text" id="mdtxtNombreCompleto" name="mdtxtNombreCompleto" placeholder="Nombre Completo" aria-required="true">
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Correo <span class="req">*</span></label>
											<input class="form-control" type="email" id="mdtxtCorreo" name="mdtxtCorreo" placeholder="Correo">
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col">
										<div class="mb-3">
											<label class="form-label">Login <span class="req">*</span></label>
											<input class="form-control" type="text" id="mdxtLoginAcceso" name="mdxtLoginAcceso" placeholder="Login" aria-required="true">
										</div>
									</div>
									<div class="col">
										<div class="mb-4">
											<label class="form-label">Contraseña <span class="req">*</span></label>
											<input class="form-control" type="text" id="mdtxtPass" name="mdtxtPass" placeholder="Contraseña">
										</div>
									</div>
									<div class="col">
										<div class="mb-4">
											<label class="form-label">Repetir Contraseña <span class="req">*</span></label>
											<input class="form-control" type="text" id="mdtxtPassVal" name="mdtxtPassVal" placeholder="Contraseña">
										</div>
									</div>
									<div class="col" id="divCambiarPass" name="divCambiarPass">
										<div class="mb-3">
											<label class="form-label">Cambiar Contraseña</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" id="mdchkCambiaPwd" name="mdchkCambiaPwd" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Tipo Documento <span class="req">*</span></label>
											<select class="form-select digits" id="mdselTipoDoc" name="mdselTipoDoc">
											</select>
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Numero Documento <span class="req">*</span></label>
											<input class="form-control" type="text" id="mdtxtNumDoc" name="mdtxtNumDoc" placeholder="Numero">
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Banco </label>
											<select class="form-select digits" id="mdselBanco" name="mdselBanco">
											</select>
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Cuenta Bancaria </label>
											<input class="form-control" type="text" id="mdtxtCCTA" name="mdtxtCCTA" placeholder="Numero">
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Perfil <span class="req">*</span></label>
											<select class="form-select digits" id="mdselPerfil" name="mdselPerfil">
											</select>
										</div>
									</div>
									<div class="col-sm-12 col-6-6">
										<div class="mb-3">
											<label class="form-label">Pais <span class="req">*</span></label>
											<select class="form-select digits" id="mdselpais" name="mdselpais">
											</select>
										</div>
									</div>
									<div class="col-sm-12 col-6-5">
										<div class="mb-3">
											<label class="form-label">Valido desde <span class="req">*</span></label>
											<input type="date" class="form-control" id="mdfecDesde" name="mdfecDesde">
										</div>
									</div>
									<div class="col-sm-12 col-6-5">
										<div class="mb-3">
											<label class="form-label">Valido hasta <span class="req">*</span></label>
											<input type="date" class="form-control" id="mdfechasta" name="mdfechasta">
										</div>
									</div>
									<div class="col-sm-12 col-6-2">
										<div class="mb-3">
											<label class="form-label">Estado</label>
											<div class="media-body text-start icon-state">
												<label class="switch">
													<input type="checkbox" checked="" id="mdchkEstado" name="mdchkEstado" wfd-id="id8"><span class="switch-state"></span>
												</label>
											</div>
										</div>
									</div>
									<div class="col-sm-12 col-6-5" id="divfechaultima" name="divfechaultima">
										<div class="mb-3">
											<label class="form-label">Ultimo Acceso</label>
											<input type="date" class="form-control" id="mdfecUltimo" name="mdfecUltimo" readonly>
										</div>
									</div>
									<div class="col-sm-12 col-6-12">
										<div>
											<label class="form-label">Comentarios</label>
											<textarea class="form-control" rows="4" id="mdtxtComentarios" name="mdtxtComentarios" placeholder="Ingrese alguna descripción sobre el usuario."></textarea>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cerrar</button>
						<button class="btn btn-primary" id="Guardar" name="Guardar" onclick="clickValidar();" type="button">Grabar</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Script {
	<!-- Plugins JS start-->
	<script src="../assets/js/sidebar-menu.js"></script>
	<script src="../assets/js/slick/slick.min.js"></script>
	<script src="../assets/js/slick/slick.js"></script>
	<script src="../assets/js/header-slick.js"></script>

	<script src="~/assets/js/jquery-3.6.0.min.js"></script>
	<script src="~/assets/js/jquery.ui.min.js"></script>
	<script src="~/assets/js/typeahead/typeahead.bundle.js"></script>
	<script src="../assets/js/select2/select2.full.min.js"></script>
	<script src="../assets/js/select2/select2-custom.js"></script>

	<script src="~/assets/js/datatable/datatablesv2/datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/datatables.fixedcolumns.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/fixedcolumns.datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/datatables.select.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/select.datatables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/dataTables.buttons.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.dataTables.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/jszip.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/pdfmake.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/vfs_fonts.js"></script>

	<script src="~/assets/js/datepicker/daterange-picker/moment.min.js"></script>
	<script src="~/assets/js/datepicker/daterange-picker/daterangepicker.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.html5.min.js"></script>
	<script src="~/assets/js/datatable/datatablesv2/buttons.print.min.js"></script>
	
	<script src="~/assets/js/jquery.validate.js"></script>
	<script src="~/assets/js/additional-methods.js"></script>
	<script src="~/assets/js/moment.js"></script>
	<script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

	<!-- Plugins JS Ends-->
	<!-- Theme js-->
	<script src="../assets/js/script.js"></script>
	<script src="~/travel/General.js?v=1.55"></script>
	<script src="~/travel/usuario.js?v=1.78"></script>
}


